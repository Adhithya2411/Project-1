27-08-2026.txt

# Derived experiment caches. Regenerated by the scripts that consume them;
# route_records is a multi-megabyte dump of the offline route sweep.
improvement_files/ml_router_training/artifacts/route_records-*.json

# Experiment reports are derived, but tracked deliberately: they are what the
# UI's Evaluation page renders and what a write-up cites, and regenerating them
# means re-running hours of experiments. `data/*` above (rather than `data/`)
# is what makes these negations effective — a negation cannot re-include a path
# whose parent directory is itself excluded.
!data/reports/
!data/reports/*.json
