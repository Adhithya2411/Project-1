# ------------------------------------------------------------------------------
# AHRAG configuration. Copy to `.env` and edit. Every value has a safe default,
# so an empty `.env` (or none at all) still produces a fully working offline run.
# ------------------------------------------------------------------------------

# --- Paths -------------------------------------------------------------------
AHRAG_DATA_DIR=./data
AHRAG_DB_PATH=./data/ahrag.sqlite3
AHRAG_ROUTER_CONFIG=./config/router.yaml

# --- Retrieval backends ------------------------------------------------------
# Embedding backend: "auto" | "sentence-transformers" | "hashing"
#   auto     -> use sentence-transformers if importable, else hashing
#   hashing  -> deterministic offline character/word n-gram embedding (no downloads)
AHRAG_EMBEDDING_BACKEND=auto
AHRAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
AHRAG_EMBEDDING_DIM=384

# Vector store: "auto" | "chroma" | "numpy"
AHRAG_VECTOR_STORE=auto

# Reranker: "auto" | "cross-encoder" | "lexical"
AHRAG_RERANKER=auto
AHRAG_CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Chunking ----------------------------------------------------------------
AHRAG_CHUNK_TARGET_CHARS=900
AHRAG_CHUNK_OVERLAP_CHARS=150

# --- Generation --------------------------------------------------------------
# Leave ANTHROPIC_API_KEY unset to use the deterministic extractive generator.
# When set, AHRAG uses the Anthropic adapter but keeps identical evidence gates.
# ANTHROPIC_API_KEY=
AHRAG_ANTHROPIC_MODEL=claude-sonnet-5
AHRAG_GENERATION_MAX_TOKENS=800

# Estimated USD per 1M tokens, used only for the *estimated* cost column.
# These are local accounting constants for the prototype, not billing figures.
AHRAG_COST_PER_MTOK_INPUT=3.0
AHRAG_COST_PER_MTOK_OUTPUT=15.0

# --- Audit / privacy ---------------------------------------------------------
# Default false: audit records store a SHA-256 query hash and chunk IDs only,
# never raw query text or raw evidence text. Set true ONLY for local debugging.
AHRAG_VERBOSE_AUDIT=false
AHRAG_LOG_LEVEL=INFO

# --- API / UI ----------------------------------------------------------------
AHRAG_API_HOST=127.0.0.1
AHRAG_API_PORT=8000
AHRAG_API_BASE_URL=http://127.0.0.1:8000

# --- Determinism -------------------------------------------------------------
AHRAG_RANDOM_SEED=1729
